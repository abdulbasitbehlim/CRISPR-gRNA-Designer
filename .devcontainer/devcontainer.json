{
  "name": "CRISPR Studio v3.2",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py",
        "ARCHITECTURE.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "python -m pip install --upgrade pip && pip install -r requirements-dev.txt",
  "postAttachCommand": {
    "server": "streamlit run app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "CRISPR Studio",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
